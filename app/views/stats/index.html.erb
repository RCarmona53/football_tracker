<h1>Match Stats for <%= @player.first_name %> <%= @player.last_name %></h1>

<div class="table-responsive">
  <table class="table table-bordered table-striped table-hover">
    <thead>
      <tr>
        <th>Date</th>
        <th>Rival</th>
        <th>Goals</th>
        <th>Presence</th>
        <% if current_user.admin? %>
          <th>Actions</th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <% @stats.each do |stat| %>
        <tr>
          <td><%= stat.match.date.strftime('%Y-%m-%d') if stat.match %></td>
          <td><%= stat.match.rival if stat.match %></td>
          <td><%= stat.goals %></td>
          <td><%= stat.present ? '✅' : '❌' %></td>
          <% if current_user.admin? %>
            <td>
              <div class="d-flex">
                <%= link_to 'Edit', edit_player_stat_path(@player, stat), class: 'btn btn-sm btn-primary me-1' %>
                <%= button_to 'Delete', player_stat_path(@player, stat), method: :delete, data: { confirm: 'Are you sure?' }, class: 'btn btn-sm btn-danger' %>
              </div>
            </td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<% if current_user.admin? %>
  <div class="actions">
    <%= link_to 'Add Stats', new_player_stat_path(@player) %>
  </div>
<% end %>

<%= link_to 'Back to Players', players_path %>
